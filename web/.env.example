# The deployment this app reads and writes. The default in lib/config.ts is
# the deployment of record; set this only to point the app at another one,
# and every page will say it is not the deployment of record.
# NEXT_PUBLIC_OCCURRA_CONTRACT=0x...

# Optional network overrides (defaults: GenLayer Studio Next, chain 61997).
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
# NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
# NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
